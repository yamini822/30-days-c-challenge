#include <stdio.h>

int main(void)
{
    int a[12];
    int n, i, j, k;
    int sum = 0, min, max;
    int second, foundSecond = 0;
    int peaks = 0, run = 1, longest = 1;
    int shifts, temp;
    int R = 67;                /* last two digits of AP26110090167 */
    int D, count = 0;
    float avg;

    /* ---------- Read N (valid range 5 to 12) ---------- */
    printf("Enter number of readings N (5-12): ");
    while (scanf("%d", &n) != 1 || n < 5 || n > 12) {
        while (getchar() != '\n');            /* clear wrong input */
        printf("Invalid N! Enter a value from 5 to 12: ");
    }

    /* ---------- Read the readings (valid range 0 to 1000) ---------- */
    for (i = 0; i < n; i++) {
        printf("Enter reading %d (0-1000): ", i + 1);
        while (scanf("%d", &a[i]) != 1 || a[i] < 0 || a[i] > 1000) {
            while (getchar() != '\n');
            printf("Invalid reading! Enter a value from 0 to 1000: ");
        }
    }

    /* ---------- Task 1: display original readings ---------- */
    printf("\n1) Original readings : ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    /* ---------- Task 2: sum, average, min, max ---------- */
    min = max = a[0];
    for (i = 0; i < n; i++) {
        sum += a[i];
        if (a[i] < min) min = a[i];
        if (a[i] > max) max = a[i];
    }
    avg = (float)sum / n;
    printf("\n2) Sum = %d, Average = %.2f, Minimum = %d, Maximum = %d",
           sum, avg, min, max);

    /* ---------- Task 3: second-largest DISTINCT value ---------- */
    for (i = 0; i < n; i++) {
        if (a[i] != max) {                    /* ignore copies of max */
            if (foundSecond == 0 || a[i] > second) {
                second = a[i];
                foundSecond = 1;
            }
        }
    }
    if (foundSecond)
        printf("\n3) Second-largest distinct value = %d", second);
    else
        printf("\n3) No second-largest distinct value exists "
               "(all readings are equal)");

    /* ---------- Task 4: count local peaks ---------- */
    for (i = 1; i < n - 1; i++) {             /* interior elements only */
        if (a[i] > a[i - 1] && a[i] > a[i + 1])
            peaks++;
    }
    printf("\n4) Number of local peaks = %d", peaks);

    /* ---------- Task 5: longest strictly increasing run ---------- */
    for (i = 1; i < n; i++) {
        if (a[i] > a[i - 1])
            run++;                            /* run continues */
        else
            run = 1;                          /* run breaks, restart */
        if (run > longest)
            longest = run;
    }
    printf("\n5) Longest strictly increasing run = %d", longest);

    /* ---------- Task 6: rotate right by K (no second array) ---------- */
    printf("\n\nEnter K (positive = right, negative = left): ");
    while (scanf("%d", &k) != 1) {
        while (getchar() != '\n');
        printf("Invalid K! Enter an integer: ");
    }
    shifts = k % n;                           /* now -(n-1) to (n-1) */
    if (shifts < 0)
        shifts = shifts + n;                  /* left rotation -> right */

    for (j = 0; j < shifts; j++) {            /* one right shift per loop */
        temp = a[n - 1];                      /* save last element */
        for (i = n - 1; i > 0; i--)
            a[i] = a[i - 1];                  /* move everything right */
        a[0] = temp;                          /* last goes to front */
    }
    printf("6) Array after rotation (K = %d) : ", k);
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    /* ---------- Task 7: personalised divisor ---------- */
    D = (R % 9) + 1;
    for (i = 0; i < n; i++) {
        if (a[i] % D == 0)
            count++;
    }
    printf("\n7) R = %d, D = %d, values divisible by D = %d\n", R, D, count);

    return 0;
}
